    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waafer1/dsh-jipu.git"
  },
  "homepage": "https://github.com/waafer1/dsh-jipu#readme",
  "bugs": {
    "url": "https://github.com/waafer1/dsh-jipu/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "writing",
    "novel",
    "manuscript",
    "outline"
  ],
  "publishConfig": {
    "access": "public"
  }
}
