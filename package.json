{
  "name": "dsh-jipu",
  "version": "1.32.0",
  "type": "module",
  "description": "Jipu manuscript crew for DSH: reader-first long-form novel pipeline, 14 gate scripts, 12 genre libraries.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "skill/**",
    "locale/*.json",
    "icon.svg"
  ],
